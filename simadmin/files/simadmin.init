#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/simadmin
HOST=0.0.0.0
PORT=3000

start_service() {
	pgrep -x dbus-daemon >/dev/null 2>&1 || /etc/init.d/dbus start 2>/dev/null
	pgrep -x ModemManager >/dev/null 2>&1 || /etc/init.d/modemmanager start 2>/dev/null
	procd_open_instance
	procd_set_param command "$PROG" --host "$HOST" --port "$PORT"
	procd_set_param env SIMADMIN_DATA_DIR=/etc/simadmin
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger simadmin
}

#!/bin/sh

. /lib/functions.sh
. /lib/netifd/netifd-proto.sh
. /usr/share/ModemManager/modemmanager.common

# When set to 1, the monitor is being stopped by procd (service stop/restart)
# and the availability of all interfaces must be cleared. It is NOT set when
# the mmcli -M listener dies on its own, in which case we just reconnect.
MONITOR_STOPPING=0
MONITOR_CHILD=""

trap_with_arg() {
	func="$1" ; shift
	pid="$1" ; shift
	for sig ; do
		# shellcheck disable=SC2064
		trap "$func $sig $pid" "$sig"
	done
}

func_trap() {
	local monitor_cache_line object

	MONITOR_STOPPING=1

	logger "ModemManager-monitor[$$]" "Sending signal ${1} ..."

	# Set all configured logical interfaces to unavailable
	while IFS= read -r monitor_cache_line; do
		object=$(echo "${monitor_cache_line}" | awk '{print $1}')
		mm_monitor_cache_remove "$object"
	done < ${MODEMMANAGER_MONITOR_CACHE}

	# stop the listener pipeline; the mmcli -M process will exit on its own
	# once the pipe reader is gone
	[ -n "${MONITOR_CHILD}" ] && kill "-${1}" "${MONITOR_CHILD}" 2>/dev/null
}

# Returns the value of the 'modem.generic.device' field (field 2) of the
# cached monitor entry for the given D-Bus object path. This is the value
# matched against the uci 'device' option by mm_get_modem_config(), NOT the
# physdev path (field 3) - do not "fix" this to field 3.
mm_monitor_get_generic_device() {
	local object="$1"

	# If no monitor cache file, we're done
	[ -f "${MODEMMANAGER_MONITOR_CACHE}" ] || return

	awk -v object="${object}" '!/^#/ && $0 ~ object { print $2 }' "${MODEMMANAGER_MONITOR_CACHE}"
}

mm_monitor_cache_remove() {
	local object="$1"

	local device cfg

	device=$(mm_monitor_get_generic_device "${object}")

	cfg=$(mm_get_modem_config "${device}")
	if [ -n "${cfg}" ]; then
		mm_log "debug" "interface '${cfg}' set '${device}' state unavailable"
		proto_set_available "${cfg}" 0
	fi

	mm_log "debug" "delete object '$object' from monitore cache"

	# On monitor remove event, remove old events from cache
	# Also substitute object path '/org/freedesktop/ModemManager1/Modem/<number>'
	# all '/' with '\/' to make sed happy with shell expansion
	sed -i "/${object//\//\\/}/d" "${MODEMMANAGER_MONITOR_CACHE}"
}

mm_monitor_cache_add() {
	local object="$1"
	local modemstatus device sysfspath cfg

	modemstatus="$(mmcli --modem="${object}" --output-keyvalue)"

	device=$(modemmanager_get_field "${modemstatus}" "modem.generic.device")
	[ -n "${device}" ] || {
		mm_log "err" "No 'device' for object '$object' not found..."
		return 1
	}

	sysfspath=$(modemmanager_get_field "${modemstatus}" "modem.generic.physdev")
	[ -n "${sysfspath}" ] || {
		mm_log "err" "No 'sysfspath' for object '$object' not found..."
		return 2
	}

	mm_log "debug" "add object '$object' to monitore cache (device=${device},sysfspath=${sysfspath})"

	# On monitor add event, store event details in cache (if not exists yet)
	grep -qs "${sysfspath}" "${MODEMMANAGER_MONITOR_CACHE}" || \
		echo "${object} ${device} ${sysfspath}" >> "${MODEMMANAGER_MONITOR_CACHE}"

	cfg=$(mm_get_modem_config "${device}")
	if [ -n "${cfg}" ]; then
		mm_log "info" "interface '${cfg}' set '${device}' state available"
		proto_set_available "${cfg}" 1
	fi
}

mm_monitor_cache_del() {
	local object="$1"

	mm_monitor_cache_remove "$object"
}

mm_monitor_cache() {
	local line="$1"
	local event object

	event="$(echo "$line" | cut -d " " -f 1)"
	object="$(echo "$line" | cut -d " " -f 2)"

	case "$event" in
		"(+)")
			mm_monitor_cache_add "$object"
			;;
		"(-)")
			mm_monitor_cache_del "$object"
			;;
	esac
}

# Reconcile the monitor cache with the list of modems currently known to
# ModemManager. Needed after reconnecting the mmcli -M listener, because
# the listener only reports incremental events and would otherwise miss
# modems that appeared or disappeared while it was down.
mm_monitor_reconcile() {
	local paths path cache_snapshot line

	paths="$(mmcli -L 2>/dev/null | grep -oE '/org/freedesktop/ModemManager1/Modem/[0-9]+' | sort -u || true)"

	# remove stale cache entries (cached but no longer present in MM)
	if [ -f "${MODEMMANAGER_MONITOR_CACHE}" ]; then
		cache_snapshot="$(cat "${MODEMMANAGER_MONITOR_CACHE}" 2>/dev/null || true)"
		while IFS= read -r line; do
			[ -n "${line}" ] || continue
			path="$(echo "${line}" | awk '{print $1}')"
			echo "${paths}" | grep -qF "${path}" || mm_monitor_cache_remove "${path}"
		done <<EOF
${cache_snapshot}
EOF
	fi

	# add missing entries (present in MM but not cached)
	for path in ${paths}; do
		grep -qsF "^${path} " "${MODEMMANAGER_MONITOR_CACHE}" 2>/dev/null || \
			mm_monitor_cache_add "${path}"
	done
}

main() {

	local n=60
	local step=1
	local mmrunning=0

	mkdir -p "${MODEMMANAGER_RUNDIR}"
	chmod 0755 "${MODEMMANAGER_RUNDIR}"

	# Wait for ModemManager to be available in the bus
	while [ $n -ge 0 ]; do
		sleep $step
		mm_log "info" "Checking if ModemManager is available..."

		if ! /usr/bin/mmcli -L >/dev/null 2>&1; then
			mm_log "info" "ModemManager not yet available (count=${n})"
		else
			mmrunning=1
			break
		fi
		n=$((n-step))
	done

	[ ${mmrunning} -eq 1 ] || {
		mm_log "error" "couldn't report initial kernel events: ModemManager not running"
		return
	}

	# before the listener pipeline exists, just flag the stop request
	trap 'MONITOR_STOPPING=1' SIGINT SIGTERM

	# Listener loop: if the mmcli -M listener dies on its own (e.g. D-Bus
	# hiccup or ModemManager restart), reconnect after a short delay instead
	# of exiting. Exiting would make procd respawn us, and every respawn
	# cycle used to tear down the availability of all modem interfaces.
	while [ "${MONITOR_STOPPING}" = "0" ]; do
		sh -c "echo \$\$; exec /usr/bin/mmcli -M" | {
			read -r monitor_pid
			while read -r line; do
				[ "${MONITOR_STOPPING}" = "0" ] || break
				mm_log "debug" "Monitor cache line: ${line}"
				mm_monitor_cache "$line"
			done
		} &
		child="$!"
		MONITOR_CHILD="$child"
		trap_with_arg func_trap "$child" SIGINT SIGTERM
		wait "$child"
		MONITOR_CHILD=""

		[ "${MONITOR_STOPPING}" = "0" ] || break

		mm_log "info" "mmcli -M listener exited, reconciling and reconnecting in 5s"
		mm_monitor_reconcile
		sleep 5
	done

	mm_log "info" "monitor stopped"
}

main "$@"

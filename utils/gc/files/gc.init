#!/bin/sh /etc/rc.common

START=90
STOP=30

USE_PROCD=1
PROG=/usr/bin/gc
CONFIGFS=/sys/kernel/config
ADBD_INIT=/etc/init.d/adbd
ADB_FFS=/dev/usb-ffs/adb
DIAG_FFS=/dev/ffs-diag
DIAG_LOG=/tmp/diag.log
DIAG_GADGET=$CONFIGFS/usb_gadget/g2
ADB_GADGET=$CONFIGFS/usb_gadget/g1
ROLE_PATH=/sys/class/udc/ci_hdrc.0/device/driver/ci_hdrc.0/role

get_config() {
	local option="$1"
	local default="$2"
	local value

	value="$(uci -q get "gc.config.$option")"
	if [ -n "$value" ]; then
		echo "$value"
	else
		echo "$default"
	fi
}

get_mode() {
	get_config mode gadget
}

set_role() {
	local role="$1"

	[ -e "$ROLE_PATH" ] || return 1
	[ -w "$ROLE_PATH" ] || return 1

	echo "$role" > "$ROLE_PATH"
}

ensure_configfs() {
	if ! grep -qs " $CONFIGFS " /proc/mounts; then
		mount -t configfs none "$CONFIGFS"
	fi
}

start_adbd() {
	if [ "$(get_config adb 0)" -ne 1 ]; then
		return 0
	fi

	mkdir -p "$ADB_FFS"
	if ! grep -qs " $ADB_FFS " /proc/mounts; then
		mount -t functionfs adb "$ADB_FFS" || return 1
	fi

	if [ -e "$ADBD_INIT" ]; then
		"$ADBD_INIT" start
		sleep 2
	fi
}

stop_adbd() {
	ubus call service delete '{"name":"adbd"}' 2>/dev/null
	sleep 1

	if pidof adbd >/dev/null 2>&1; then
		kill -9 $(pidof adbd) 2>/dev/null
		sleep 1
	fi

	if grep -qs " $ADB_FFS " /proc/mounts; then
		umount "$ADB_FFS" 2>/dev/null
	fi
}

ensure_rpmsg_nodes() {
	local n d maj min

	for n in 0 1 2 3 4 5; do
		d=/sys/class/rpmsg/rpmsg$n
		[ -e $d ] || continue
		[ -c /dev/rpmsg$n ] && continue
		rm -f /dev/rpmsg$n
		maj=$(grep MAJOR $d/uevent | cut -d= -f2)
		min=$(grep MINOR $d/uevent | cut -d= -f2)
		[ -n "$maj" ] && [ -n "$min" ] && mknod /dev/rpmsg$n c $maj $min
	done
}

diag_ctrl() {
	local n link

	for n in 0 1 2 3; do
		[ -e /dev/rpmsg_ctrl$n ] || continue
		link=$(readlink /sys/class/rpmsg/rpmsg_ctrl$n/device 2>/dev/null)
		case "$link" in
			*remoteproc0:smd-edge*)
				echo /dev/rpmsg_ctrl$n
				return 0
				;;
		esac
	done

	echo /dev/rpmsg_ctrl0
}

start_diag() {
	local ctrl udc i=0

	while [ $i -lt 20 ]; do
		ls /sys/bus/rpmsg/devices/ 2>/dev/null | grep -q "smd-edge.DIAG.-1.-1" && break
		i=$((i + 1))
		sleep 1
	done

	ensure_configfs || return 1

	stop_adbd
	gc -c 2>/dev/null

	ctrl=$(diag_ctrl)
	rpmsgexport "$ctrl" DIAG 2>/dev/null
	rpmsgexport "$ctrl" DIAG_CNTL 2>/dev/null
	rpmsgexport "$ctrl" DIAG_CMD 2>/dev/null

	ensure_rpmsg_nodes

	mkdir -p "$DIAG_GADGET/strings/0x409" "$DIAG_GADGET/configs/c.1/strings/0x409" \
		"$DIAG_GADGET/functions/ffs.diag"
	echo 0x05c6 > "$DIAG_GADGET/idVendor"
	echo 0x901D > "$DIAG_GADGET/idProduct"
	echo 0x0200 > "$DIAG_GADGET/bcdUSB"
	echo 0x00 > "$DIAG_GADGET/bDeviceClass"
	echo 0x00 > "$DIAG_GADGET/bDeviceSubClass"
	echo 0x00 > "$DIAG_GADGET/bDeviceProtocol"
	echo 0x40 > "$DIAG_GADGET/bMaxPacketSize0"
	echo 0x0100 > "$DIAG_GADGET/bcdDevice"
	echo 0123456789 > "$DIAG_GADGET/strings/0x409/serialnumber"
	echo Qualcomm > "$DIAG_GADGET/strings/0x409/manufacturer"
	echo Android > "$DIAG_GADGET/strings/0x409/product"
	echo diag > "$DIAG_GADGET/configs/c.1/strings/0x409/configuration"
	ln -s "$DIAG_GADGET/functions/ffs.diag" "$DIAG_GADGET/configs/c.1/1.diag" 2>/dev/null

	if [ "$(get_config adb 0)" -eq 1 ]; then
		mkdir -p "$DIAG_GADGET/functions/ffs.adb"
		ln -s "$DIAG_GADGET/functions/ffs.adb" "$DIAG_GADGET/configs/c.1/2.adb" 2>/dev/null
	fi

	mkdir -p "$DIAG_FFS"
	mount -t functionfs diag "$DIAG_FFS" || return 1

	if [ "$(get_config adb 0)" -eq 1 ]; then
		mkdir -p "$ADB_FFS"
		mount -t functionfs adb "$ADB_FFS" 2>/dev/null
	fi

	/usr/bin/diag-router > "$DIAG_LOG" 2>&1 &
	sleep 1

	if [ "$(get_config adb 0)" -eq 1 ]; then
		[ -e "$ADBD_INIT" ] && "$ADBD_INIT" start
		sleep 1
	fi

	udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
	[ -n "$udc" ] || return 1
	echo "$udc" > "$DIAG_GADGET/UDC" || return 1

	return 0
}

stop_diag() {
	echo "" > "$DIAG_GADGET/UDC" 2>/dev/null
	kill -9 $(pidof diag-router) 2>/dev/null
	umount "$DIAG_FFS" 2>/dev/null
}

wait_ffs_ready() {
	local dir="$1" tag="$2" i=0

	while [ $i -lt 10 ] && [ ! -e "$dir/ep1" ]; do
		i=$((i + 1))
		sleep 1
	done
	if [ ! -e "$dir/ep1" ]; then
		logger -t gc "$tag: ffs endpoints not ready"
		return 1
	fi
	return 0
}

start_adb_gadget() {
	local udc

	ensure_configfs || return 1
	stop_adbd
	stop_diag
	gc -c 2>/dev/null

	mkdir -p "$ADB_GADGET/strings/0x409" "$ADB_GADGET/configs/c.1/strings/0x409" \
		"$ADB_GADGET/functions/ffs.adb"
	echo 0x18d1 > "$ADB_GADGET/idVendor"
	echo 0x4ee7 > "$ADB_GADGET/idProduct"
	echo 0x0200 > "$ADB_GADGET/bcdUSB"
	echo 0x00 > "$ADB_GADGET/bDeviceClass"
	echo 0x00 > "$ADB_GADGET/bDeviceSubClass"
	echo 0x00 > "$ADB_GADGET/bDeviceProtocol"
	echo 0x40 > "$ADB_GADGET/bMaxPacketSize0"
	echo 0x0100 > "$ADB_GADGET/bcdDevice"
	echo 0123456789 > "$ADB_GADGET/strings/0x409/serialnumber"
	echo Google > "$ADB_GADGET/strings/0x409/manufacturer"
	echo Android > "$ADB_GADGET/strings/0x409/product"
	echo adb > "$ADB_GADGET/configs/c.1/strings/0x409/configuration"
	rm -f "$ADB_GADGET/configs/c.1/1.adb" 2>/dev/null
	ln -s "$ADB_GADGET/functions/ffs.adb" "$ADB_GADGET/configs/c.1/1.adb" 2>/dev/null
	[ -L "$ADB_GADGET/configs/c.1/1.adb" ] || { logger -t gc "ln -s 1.adb failed"; return 1; }

	mkdir -p "$ADB_FFS"
	grep -qs " $ADB_FFS " /proc/mounts || mount -t functionfs adb "$ADB_FFS" || { logger -t gc "mount $ADB_FFS failed"; return 1; }

	kill -9 $(pidof adbd) 2>/dev/null
	sleep 1
	[ -e "$ADBD_INIT" ] && "$ADBD_INIT" start
	wait_ffs_ready "$ADB_FFS" adbd || return 1

	udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
	[ -n "$udc" ] || { logger -t gc "no udc found"; return 1; }
	echo "$udc" > "$ADB_GADGET/UDC" || { logger -t gc "bind udc failed"; return 1; }
	logger -t gc "adb gadget up: udc=$udc"

	return 0
}

configure_gadget() {
	local rndis mass mass_path serial hid ecm ncm acm printer midi diag

	rndis=$(get_config rndis 0)
	mass=$(get_config mass 0)
	mass_path=$(get_config mass_path /)
	serial=$(get_config serial 0)
	hid=$(get_config hid 0)
	ecm=$(get_config ecm 0)
	ncm=$(get_config ncm 0)
	acm=$(get_config acm 0)
	printer=$(get_config printer 0)
	midi=$(get_config midi 0)
	diag=$(get_config diag 0)

	ensure_configfs || return 1

	if [ "$diag" -eq 1 ]; then
		start_diag || return 1
		return 0
	fi

	gc -c
	if [ "$ecm" -eq 1 ]; then
		gc -a ecm
	fi
	if [ "$ncm" -eq 1 ]; then
		gc -a ncm
	fi
	if [ "$rndis" -eq 1 ]; then
		gc -a rndis
	fi
	if [ "$serial" -eq 1 ]; then
		gc -a serial
	fi
	if [ "$hid" -eq 1 ]; then
		gc -a hid
	fi
	if [ "$acm" -eq 1 ]; then
		gc -a acm
	fi
	if [ "$printer" -eq 1 ]; then
		gc -a printer
	fi
	if [ "$midi" -eq 1 ]; then
		gc -a midi
	fi
	if [ "$mass" -eq 1 ]; then
		gc -a mass "$mass_path"
	fi
	if [ "$(get_config adb 0)" -eq 1 ] && [ "$rndis$mass$serial$hid$ecm$ncm$acm$printer$midi" = "000000000" ]; then
		start_adb_gadget || return 1
		return 0
	fi

	if [ "$(get_config adb 0)" -eq 1 ]; then
		gc -a ffs
		start_adbd || return 1
	fi

	gc -e
}

apply_gadget_mode() {
	set_role gadget || return 1

	if [ "$(get_config enabled 0)" -ne 1 ]; then
		return 0
	fi

	configure_gadget
}

apply_host_mode() {
	stop_service
	set_role host
}

start_service() {
	case "$(get_mode)" in
		host)
			apply_host_mode
			;;
		*)
			apply_gadget_mode
			;;
	esac

}

stop_service() {
	stop_diag
	stop_adbd
	timeout 8 gc -d
	gc -c

}

restart() {
	stop
	start
}

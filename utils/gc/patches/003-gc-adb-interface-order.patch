+static int gc_pick_id_product(usbg_gadget *g)
+{
+    usbg_function *f;
+    int adb = 0, rndis = 0, other = 0;
+
+    if (g == NULL)
+        return -1;
+
+    for (f = usbg_get_first_function(g); f != NULL;
+         f = usbg_get_next_function(f)) {
+        switch (usbg_get_function_type(f)) {
+        case USBG_F_FFS:
+            adb++;
+            break;
+        case USBG_F_RNDIS:
+            rndis++;
+            break;
+        default:
+            other++;
+            break;
+        }
+    }
+
+    if (adb != 1)
+        return -1;
+
+    if (rndis == 1 && other == 0)
+        return 0x4EE4;
+
+    if (rndis == 0 && other == 0)
+        return 0x4EE7;
+
+    return -1;
+}

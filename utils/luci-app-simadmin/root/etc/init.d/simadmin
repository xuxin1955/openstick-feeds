#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

start_service() {
	i=0
	while [ "$i" -lt 10 ]; do
		dbus-send --system --type=method_call --print-reply --dest=org.freedesktop.ModemManager1 /org/freedesktop/ModemManager1 org.freedesktop.ModemManager1.SetLogging string:INFO >/dev/null 2>&1 && break
		i=$((i + 1))
		sleep 2
	done
	procd_open_instance
	procd_set_param command /opt/simadmin/start.sh
	procd_set_param env SIMADMIN_DATA_DIR=/opt/simadmin/data
	procd_set_param env RUST_LOG=info
	procd_set_param respawn 3600 5 60
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0 0"
	procd_close_instance
}

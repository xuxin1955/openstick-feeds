#!/bin/sh

f=$(grep -rl '"admin/network"' /usr/share/luci/menu.d/ 2>/dev/null | head -n 1)
net=$(jsonfilter -s "$(cat "$f" 2>/dev/null)" -e '@["admin/network"].order' 2>/dev/null)
[ -z "$net" ] && net=30
new=$((net - 1))
cat > /usr/share/luci/menu.d/luci-app-simadmin.json <<EOF
{
	"admin/simadmin": {
		"title": "SimAdmin",
		"order": $new,
		"action": {
			"type": "view",
			"path": "simadmin/overview"
		}
	}
}
EOF
rm -f /tmp/luci-indexcache*

exit 0

#!/bin/sh /etc/rc.common
#
# Copyright (C) 2026 xuxin1955
#
# procd init script for DbusSmsForwardCPlus.
#
# The program only understands a plain "key = value" config.txt, and it blocks
# on stdin waiting for a mode to be chosen when started without any mode
# argument. So this script has to:
#   1. render config.txt from the UCI config first (into tmpfs)
#   2. always pass at least one -f* or --sendsmsapi=enable
#   3. never be interactive

START=95
STOP=10

USE_PROCD=1

PROG=/usr/bin/DbusSmsForwardCPlus
CONF=/var/etc/dbussmsforward.conf

TAG=dbussmsforward
SEC=main

# Read one UCI value, dropping any newline that sneaks in - a newline would
# break the line structure of config.txt.
cfg() {
	local val

	config_get val "$SEC" "$1" "$2"
	printf '%s' "$val" | tr -d '\r\n'
}

emit() {
	printf '%s = %s\n' "$1" "$2" >> "$CONF"
}

# Render the UCI config into the config.txt the program expects. Every key is
# written out, even when empty, so that none of the interactive prompts in
# ProcessSetup/ and SmsCodeProcess/ can ever trigger.
render_config() {
	local name

	mkdir -p "$(dirname "$CONF")"
	: > "$CONF"

	name="$(cfg device_name '')"
	[ -n "$name" ] || name='*Host*Name*'

	emit ForwardDeviceName        "$name"
	emit forwardIgnoreStorageType "$(cfg forward_storage 'sm')"
	emit smsCodeKey               "$(cfg sms_code_key '验证码±verification±code±인증±代码±随机码')"
	emit smsHistoryPath           "$(cfg history_file '/etc/dbussmsforward/history.jsonl')"
	emit smsHistoryMax            "$(cfg history_max '500')"

	emit smtpHost    "$(cfg email_smtp_host '')"
	emit smtpPort    "$(cfg email_smtp_port '')"
	emit emailKey    "$(cfg email_key '')"
	emit sendEmial   "$(cfg email_from '')"
	emit reciveEmial "$(cfg email_to '')"

	emit pushPlusToken "$(cfg pushplus_token '')"

	emit WeChatQYID                "$(cfg wecom_corpid '')"
	emit WeChatQYApplicationID     "$(cfg wecom_agentid '')"
	emit WeChatQYApplicationSecret "$(cfg wecom_secret '')"

	emit TGBotToken             "$(cfg telegram_token '')"
	emit TGBotChatID            "$(cfg telegram_chatid '')"
	emit IsEnableCustomTGBotApi "$(cfg telegram_custom_api 'false')"
	emit CustomTGBotApi         "$(cfg telegram_api_base '')"

	emit DingTalkAccessToken "$(cfg dingtalk_access_token '')"
	emit DingTalkSecret      "$(cfg dingtalk_secret '')"

	emit BarkUrl "$(cfg bark_server '')"
	emit BrakKey "$(cfg bark_key '')"

	emit ShellPath "$(cfg shell_path '')"

	emit apiPort "$(cfg api_port '8080')"
}

start_service() {
	local api_on=0 spec sec sw on

	config_load "$TAG"

	config_get_bool enabled "$SEC" enabled 0
	if [ "$enabled" != "1" ]; then
		logger -t "$TAG" "未启用（把 /etc/config/dbussmsforward 的 main.enabled 设为 1 才启动）"
		return 0
	fi

	render_config

	# Channel switches map onto the program's command line flags; the numbers
	# match ProcessSmsSend/sendoptionprocess.h
	FLAGS=""
	for spec in email:-fE pushplus:-fP wecom:-fW telegram:-fT dingtalk:-fD bark:-fB shell:-fS; do
		sec="${spec%%:*}"
		sw="${spec##*:}"
		config_get_bool on "$SEC" "${sec}_enabled" 0
		[ "$on" = "1" ] && FLAGS="$FLAGS $sw"
	done

	config_get_bool api_on "$SEC" api_enabled 0

	# Refuse to start with nothing selected: the program would hang on stdin
	if [ -z "$FLAGS" ] && [ "$api_on" != "1" ]; then
		logger -t "$TAG" "没有任何转发渠道或发送短信API被启用，拒绝启动（否则程序会卡在等待输入）"
		return 1
	fi

	set --
	for spec in $FLAGS; do
		set -- "$@" "$spec"
	done
	[ "$api_on" = "1" ] && set -- "$@" --sendsmsapi=enable
	set -- "$@" "--configfile=$CONF"

	logger -t "$TAG" "启动：$PROG $*"

	procd_open_instance
	procd_set_param command "$PROG" "$@"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$TAG"
}

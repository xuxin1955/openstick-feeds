# DbusSmsForwardCPlus UCI configuration
#
# The program itself only reads a "key = value" config.txt, so this file is the
# single source of truth. /etc/init.d/dbussmsforward renders it into
# /var/etc/dbussmsforward.conf on every start; the rendered copy lives on tmpfs
# so it never wears the flash and can be rewritten by the program safely.

config dbussmsforward 'main'
	# Master switch. With this at 0 the init script refuses to start.
	option enabled '0'

	# ---------------- General ----------------
	# Shown in forwarded messages; empty means the device hostname is used
	option device_name ''
	# Only forward SMS of this storage type, so that sent/draft messages are
	# not forwarded again. all=no filtering  unknown sm me mt sr bm ta
	option forward_storage 'sm'
	# Verification-code keywords, separated by ±
	option sms_code_key '验证码±verification±code±인증±代码±随机码'

	# SMS history: the program appends every forwarded message to this file so
	# the web UI can show it later. It contains verification codes in plain
	# text, so point it at /tmp if you do not want that on the flash.
	option history_file '/etc/dbussmsforward/history.jsonl'
	# Keep at most this many entries; older ones are dropped
	option history_max '500'

	# ---------------- Email ----------------
	option email_enabled '0'
	option email_smtp_host ''
	# Note: the program currently always uses port 465; this is informational
	option email_smtp_port '465'
	# Mailbox authorization code / key
	option email_key ''
	option email_from ''
	option email_to ''

	# ---------------- PushPlus ----------------
	option pushplus_enabled '0'
	option pushplus_token ''

	# ---------------- WeCom self-built app ----------------
	option wecom_enabled '0'
	option wecom_corpid ''
	option wecom_agentid ''
	option wecom_secret ''

	# ---------------- Telegram bot ----------------
	option telegram_enabled '0'
	option telegram_token ''
	option telegram_chatid ''
	# Must be exactly true or false
	option telegram_custom_api 'false'
	# Custom API base, e.g. https://xxx.abc.com
	option telegram_api_base ''

	# ---------------- DingTalk bot ----------------
	option dingtalk_enabled '0'
	option dingtalk_access_token ''
	option dingtalk_secret ''

	# ---------------- Bark ----------------
	option bark_enabled '0'
	option bark_server ''
	option bark_key ''

	# ---------------- Custom shell script ----------------
	option shell_enabled '0'
	# The script needs the executable bit. The program passes 6 arguments:
	# number, date, body, verification code, code source, device name
	option shell_path ''

	# ---------------- Send-SMS HTTP API ----------------
	option api_enabled '0'
	# http://device-ip:port/ serves a send form;
	# /api?telnum=&smstext= is the raw endpoint
	option api_port '8080'

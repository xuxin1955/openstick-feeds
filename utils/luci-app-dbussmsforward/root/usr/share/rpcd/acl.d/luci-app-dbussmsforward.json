{
	"luci-app-dbussmsforward": {
		"description": "Grant UCI, service and program access for luci-app-dbussmsforward",
		"read": {
			"uci": [ "dbussmsforward" ],
			"ubus": {
				"service": [ "list" ]
			},
			"file": {
				"/etc/init.d/dbussmsforward": [ "exec" ],
				"/usr/bin/DbusSmsForwardCPlus": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "dbussmsforward" ],
			"ubus": {
				"service": [ "list", "set", "signal" ]
			},
			"file": {
				"/etc/init.d/dbussmsforward": [ "exec" ],
				"/usr/bin/DbusSmsForwardCPlus": [ "exec" ]
			}
		}
	}
}

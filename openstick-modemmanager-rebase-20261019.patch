+	# before the listener pipeline exists, just flag the stop request
+	trap 'MONITOR_STOPPING=1' SIGINT SIGTERM
+
+	# Listener loop: if the mmcli -M listener dies on its own (e.g. D-Bus
+	# hiccup or ModemManager restart), reconnect after a short delay instead
+	# of exiting. Exiting would make procd respawn us, and every respawn
+	# cycle used to tear down the availability of all modem interfaces.
+	while [ "${MONITOR_STOPPING}" = "0" ]; do
+		sh -c "echo \$\$; exec /usr/bin/mmcli -M" | {
+			read -r monitor_pid
+			while read -r line; do
+				[ "${MONITOR_STOPPING}" = "0" ] || break
+				mm_log "debug" "Monitor cache line: ${line}"
+				mm_monitor_cache "$line"
+			done
+		} &
+		child="$!"
+		MONITOR_CHILD="$child"
+		trap_with_arg func_trap "$child" SIGINT SIGTERM
+		wait "$child"
+		MONITOR_CHILD=""
+
+		[ "${MONITOR_STOPPING}" = "0" ] || break

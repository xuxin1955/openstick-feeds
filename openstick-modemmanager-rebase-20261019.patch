+# Reconcile the monitor cache with the list of modems currently known to
+# ModemManager. Needed after reconnecting the mmcli -M listener, because
+# the listener only reports incremental events and would otherwise miss
+# modems that appeared or disappeared while it was down.
+mm_monitor_reconcile() {
+	local paths path cache_snapshot line
+
+	paths="$(mmcli -L 2>/dev/null | grep -oE '/org/freedesktop/ModemManager1/Modem/[0-9]+' | sort -u || true)"
+
+	# remove stale cache entries (cached but no longer present in MM)
+	if [ -f "${MODEMMANAGER_MONITOR_CACHE}" ]; then
+		cache_snapshot="$(cat "${MODEMMANAGER_MONITOR_CACHE}" 2>/dev/null || true)"
+		while IFS= read -r line; do
+			[ -n "${line}" ] || continue
+			path="$(echo "${line}" | awk '{print $1}')"
+			echo "${paths}" | grep -qF "${path}" || mm_monitor_cache_remove "${path}"
+		done <<EOF
+${cache_snapshot}
+EOF
+	fi
+
+	# add missing entries (present in MM but not cached)
+	for path in ${paths}; do
+		grep -qsF "^${path} " "${MODEMMANAGER_MONITOR_CACHE}" 2>/dev/null || \
+			mm_monitor_cache_add "${path}"
+	done
+}
